# Copie para .env.local e preencha. O .env.local nunca é versionado.

# --- Supabase -------------------------------------------------------------
# Painel do projeto → Settings → API

# Público: aparece no navegador, e não há problema nisso.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreto: ignora o RLS. Somente no servidor, jamais no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Conexão direta ao Postgres, usada pelas migrações.
# A senha precisa estar com os caracteres especiais codificados em percentagem.
DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# --- Publicidade ----------------------------------------------------------
# O código de editor do Google AdSense. Sem ele, não há anúncio em lugar
# nenhum do site — nem script, nem espaço reservado. O número de cada bloco
# vai em src/content/anuncios.ts, que também lista as salas onde nunca entra
# publicidade e explica por quê.
# NEXT_PUBLIC_ADSENSE_ID=ca-pub-0000000000000000

# --- Endereço público -----------------------------------------------------
# De onde saem os canonicals, o sitemap e as imagens de partilha. Sem isto,
# vale o endereço da Vercel que está em src/lib/seo/site.ts. Ao registar um
# domínio próprio, ponha-o aqui e nas variáveis do projeto na Vercel — é a
# única mudança necessária.
# NEXT_PUBLIC_SITE_URL=https://seudominio.com.br

# --- Vercel ---------------------------------------------------------------
# Apenas para `npm run publicar`. Gere em vercel.com/account/tokens
VERCEL_TOKEN=
